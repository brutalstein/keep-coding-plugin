# Absolute parent directories that may contain target Git repositories.
KEEP_CODING_ALLOWED_ROOTS=/home/me/projects

# Exact commands the remote app is allowed to save and execute as phase gates.
KEEP_CODING_ALLOWED_COMMANDS_JSON=["npm run check","npm test","git diff --check"]

KEEP_CODING_HTTP_HOST=127.0.0.1
KEEP_CODING_HTTP_PORT=8787
KEEP_CODING_HTTP_PATH=/mcp
KEEP_CODING_MAX_BODY_BYTES=1048576

# Required when binding outside loopback. Prefer Secure MCP Tunnel or an OAuth gateway.
# KEEP_CODING_ALLOWED_HOSTS=mcp.example.com
# KEEP_CODING_BEARER_TOKEN=replace-with-a-long-random-secret
