{
  "description": "Claude Code lifecycle integration for Keep Coding.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEP_CODING_RUNTIME=claude-hooks node \"${CLAUDE_PLUGIN_ROOT}/dist/keep-coding.mjs\" hook SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEP_CODING_RUNTIME=claude-hooks node \"${CLAUDE_PLUGIN_ROOT}/dist/keep-coding.mjs\" hook UserPromptSubmit",
            "timeout": 8
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEP_CODING_RUNTIME=claude-hooks node \"${CLAUDE_PLUGIN_ROOT}/dist/keep-coding.mjs\" hook PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEP_CODING_RUNTIME=claude-hooks node \"${CLAUDE_PLUGIN_ROOT}/dist/keep-coding.mjs\" hook PostCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEP_CODING_RUNTIME=claude-hooks node \"${CLAUDE_PLUGIN_ROOT}/dist/keep-coding.mjs\" hook Stop",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEP_CODING_RUNTIME=claude-hooks node \"${CLAUDE_PLUGIN_ROOT}/dist/keep-coding.mjs\" hook SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
